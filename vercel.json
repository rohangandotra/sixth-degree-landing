{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sixthdegree.app" }],
      "destination": "https://sixthdegree.app/:path*",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "https://app.sixthdegree.app/privacy",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "https://app.sixthdegree.app/terms",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/assets/favicon-48.png" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
